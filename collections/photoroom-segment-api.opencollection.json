{
  "opencollection": "1.0.0",
  "info": {
    "name": "Photoroom Account Segment API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Segment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Remove Background (Basic plan)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/segment",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Remove background from an image"
        }
      ]
    }
  ],
  "bundled": true
}